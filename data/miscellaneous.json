[  
  {
    "name": "Delete unecessary user directories.",
    "description": "Deletes ~/Desktop ~/Documents ~/Pictures ~/Videos ~/Templates ~/Music ~/Public",
    "script": "rm -rf ~/Desktop/ ~/Documents ~/Pictures/ ~/Videos/ ~/Templates/ ~/Music/ ~/Public/"
  },   
  {
    "name": "Add screenshot user directory for maim output.",
    "description": "Creates ~/Screenshots",
    "script": "mkdir -p ~/Screenshots"
  },      
  {
    "name": "Basic firewall setup",
    "description": "Deny incoming traffic, allow outgoing traffic, ",
    "script": [
            "sudo ufw default deny incoming",
            "sudo ufw default allow outgoing"
        ]
  },
  {
    "name": "Set up git profile and ssh keys",
    "description": "Set up global user data for git on this device, as well as generating ssh keys, starting the ssh agent, and setting up my private key",
    "script": [
            "git config --global user.email \"wricks2023.16@gmail.com\"",
            "git config --global user.name \"Will\"",
            "if [[ ! -d ~/.ssh ]]; then",
            "   ssh-keygen -t ed25519",
            "fi",
            "eval \"$(ssh-agent -s)\"",
            "ssh-add ~/.ssh/id_ed25519"
        ]
  },
  {
    "name": "Update system packages",
    "description": "",
    "script": "sudo apt update && sudo apt upgrade"
  },
  {
    "name": "Wine",
    "description": "Compatibility layer for executing windows programs on linux.",
    "script": [
            "if [ ! -d /opt/wine-stable/ ]; then",
            "   sudo apt remove --purge winehq-stable wine wine32 wine64",
            "   sudo rm /etc/apt/sources.list.d/winehq-noble.sources",
            "   sudo mkdir -pm755 /etc/apt/keyrings -y",
            "   wget -O - https://dl.winehq.org/wine-builds/winehq.key | sudo gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key -",
            "   sudo dpkg --add-architecture i386 -y",
            "   sudo wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources -y",
            "   sudo apt update -y",
            "   sudo apt install --install-recommends winehq-stable -y",
            "else",
            "   echo \"Wine is already installed, delete the /opt/wine-stable folder to reinstall\"",
            "fi"
        ]
  },
  {
    "name": "evremap",
    "description": "Low level key remapping tool for linux.",
    "script": [
            "if [ ! -d ~/.local/share/evremap ]; then",
            "   mkdir -p ~/.local/share/evremap",
            "   wget https://github.com/wez/evremap/archive/refs/heads/master.zip",
            "   unzip master.zip",
            "   mv evremap-master ~/.local/share/evremap/",
            "   rm master.zip",
            "   sudo apt install -y libevdev-dev pkg-config",
            "   sudo apt install -y cargo",
            "   cargo build --release --manifest-path ~/.local/share/evremap/evremap-master/Cargo.toml",
            "else",
            "   echo \"The xkeysnail config directory already exists, delete the ~/.config/xkeysnail folder to reinstall\"",
            "fi"

    ]
  },
  {
    "name": "key reassignment script - e.g. f3 remap",
    "description": "Sets up evremap config file, this can be used to assign ` to f3 instead.",
    "script": [
            "mkdir -p ~/.config/evremap",
            "cp ./data/configs/inputs.toml ~/.config/evremap/config.toml"
    ]
  },
  {
    "name": "Resetti",
    "description": "Window resizing tool for minecraft on linux",
    "script": [
        "if [[ ! -d /opt/resetti ]]; then",
        "   wget https://github.com/tesselslate/resetti/releases/download/v0.7.0/resetti",
        "   chmod +x resetti",
        "   sudo mkdir -p /opt/resetti/",
        "   sudo mv resetti /opt/resetti/resetti",
        "   /opt/resetti/resetti new mc",
        "else",
        "   echo \"Resetti is already installed, delete it at /opt/resetti to reinstall.\"",
        "fi"
    ]
  }
]
