[  
  {
    "name": "vokoscreen",
    "description": "Video recording software",
    "script": "sudo apt install -y vokoscreen-ng"
  },       
  {
    "name": "neovim",
    "description": "Basic neovim install - text editor, keyboard based",
    "script": [
        "if [ ! -f /usr/local/bin/nvim ]; then",
        "   sudo add-apt-repository ppa:neovim-ppa/stable -y",
        "   sudo apt update",
        "   git clone https://github.com/neovim/neovim.git",
        "   cd neovim",
        "   git checkout stable",
        "   make CMAKE_BUILD_TYPE=Release",
        "   sudo make install",
        "   cd ..",
        "   rm -rf neovim",
        "else",
        "   echo \"neovim is already installde. uninstall at /usr/opt/bin/nvim to reinstall\"",
        "fi"
    ]
  },
  {
    "name": "librewolf",
    "description": "Privacy focused web browser",
    "script": [
            "if ! dpkg -s extrepo &>/dev/null; then",
            "   sudo apt install -y extrepo",
            "   sudo extrepo enable librewolf",
            "   sudo apt update && sudo apt install librewolf -y",
            "   sudo apt remove -y extrepo",
            "else",
            "   sudo extrepo enable librewolf",
            "   sudo apt update && sudo apt install librewolf -y",
            "fi"
        ]
  },
  {
    "name": "Discord",
    "description": "",
    "script": [
            "if ! dpkg -s flatpak &>/dev/null; then",
            "   sudo apt install -y flatpak",
            "   flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "fi",
            "flatpak install -y --user flathub com.discordapp.Discord"
        ]
  },
  {
    "name": "Zap",
    "description": "[AFNOM] Tool for finding vulnerabilities in web applications and monitoring web traffic.",
    "script": [
            "if ! dpkg -s flatpak &>/dev/null; then",
            "   sudo apt install -y flatpak",
            "   flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "fi",
            "flatpak install -y --user flathub org.zaproxy.ZAP" 
        ]
  },
  {
    "name": "Stegsolve",
    "description": "[AFNOM] Used for manipulating images to find hidden data",
    "script": [
            "wget http://www.caesum.com/handbook/Stegsolve.jar -O stegsolve.jar",
            "chmod +x stegsolve.jar",
            "sudo mv ./stegsolve.jar /usr/local/bin/" 
        ]
  },
  {
    "name": "Ghidra",
    "description": "[AFNOM] Used for analysing binary files - e.g decompiling into source code",
    "script": [
            "if [[ ! -d /opt/ghidra ]]; then",
            "   wget https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_11.4.2_build/ghidra_11.4.2_PUBLIC_20250826.zip",
            "   if ! dpkg -s unzip &>/dev/null; then",
            "       sudo apt install -y unzip",
            "       unzip ghidra_11.4.2_PUBLIC_20250826.zip",
            "       sudo apt remove -y unzip",
            "   else",
            "       unzip ghidra_11.4.2_PUBLIC_20250826.zip",
            "   fi",
	    "   mkdir -p /opt/ghidra",
            "   sudo mv ghidra_11.4.2_PUBLIC /opt/ghidra",
            "   rm ghidra_11.4.2_PUBLIC_20250826.zip",
            "else",
            "   echo \"Ghidra is already installed, delete it at /opt/ghidra to reinstall.\"",
            "fi"
        ]
  },
  {
    "name": "Waydroid",
    "description": "Android emulator",
    "script": [
            "if ! dpkg -s waydroid >/dev/null 2>&1; then",
            "   curl -s https://repo.waydro.id | sudo bash",
            "   sudo apt install -y waydroid",
            "else",
            "   echo \"Waydroid is already installed, delete waydroid using apt first\"",
            "fi"
        ]
  },
  {
    "name": "Prism Launcher",
    "description": "Launcher for Minecraft.",
