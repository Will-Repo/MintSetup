        ]
  },
  {
    "name": "genymotion",
    "description": "[AFNOM] android emulator",
    "script": [
            "if [[ ! -d ~/.local/share/genymotion ]]; then",
            "   wget https://dl.genymotion.com/releases/genymotion-3.9.0/genymotion-3.9.0-linux_x64.run",
            "   chmod +x genymotion-3.9.0-linux_x64.run",
            "   ./genymotion-3.9.0-linux_x64.run -d ~/.local/share/ -y",
            "   rm genymotion-3.9.0-linux_x64.run",
            "else",
            "   echo \"genymotion is already installed, delete it at ~/.local/share/genymotion to reinstall.\"",
            "fi"
        ]
  },
  {
    "name": "Lutris",
    "description": "linux game manager",
    "script": [
        "if [[ ! -d ~/.local/share/lutris ]]; then",
        "   wget https://github.com/lutris/lutris/releases/download/v0.5.18/lutris_0.5.18_all.deb",
        "   sudo dpkg -i lutris_0.5.18_all.deb",
        "   rm lutris_0.5.18_all.deb",
        "else",
        "   echo \"lutris is already installed, delete it at ~/.local/share/lutris to reinstall.\"",
        "fi"
    ]
  },
  {
    "name": "TickTick",
    "description": "To do list and calender application - cross platform: android, ipados, linux",
    "script": [
        "if [[ ! -d /opt/ticktick ]]; then",
        "   wget https://download.ticktick.app/download/linux/linux_appimage_x64/ticktick-6.0.40-x86_64.AppImage",
        "   chmod +x ticktick-6.0.40-x86_64.AppImage",
        "   sudo mkdir -p /opt/ticktick",
        "   sudo mv ticktick-6.0.40-x86_64.AppImage /opt/ticktick",
        "else",
        "   echo \"ticktick is already installed, delete it at /opt/ticktick to reinstall.\"",
        "fi"
    ]
  },
  {
    "name": "LocalSend",
