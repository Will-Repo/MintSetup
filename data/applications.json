            "if ! dpkg -s flatpak &>/dev/null; then",
            "   sudo apt install -y flatpak",
            "   flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "fi",
            "flatpak install -y --user flathub org.prismlauncher.PrismLauncher"
        ]
  },
  {
    "name": "Steam",
    "description": "Game store - some games run on linux. Install also sets game install location to ~/usb/Games/steamapps",
    "script": "sudo apt install steam -y"
  },
  {
    "name": "Heroic Launcher",
    "description": "Games launcher - can run Rocket League through proton layer. Recommended: download to usb folder Laptop/Games/RocketLeague, and select for this script to be run.",
    "script": [
            "if ! dpkg -s flatpak &>/dev/null; then",
            "   sudo apt install -y flatpak",
            "   flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "fi",
