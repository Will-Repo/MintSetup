alias signout='i3-msg exit'
alias closeall='i3-msg "[class=\".*\"] kill"'
alias add='git add .'
alias commit='git commit -m'
alias ac='git add . && git commit -m'
alias push='git push -u origin $(git branch --show-current)'
alias pull='git pull -u origin $(git branch --show-current)'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ls='ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
volume() {
    pactl set-sink-volume @DEFAULT_SINK@ $1%
}
alias vol='volume'
alias v='volume'
alias whilehex='while read -r line; do echo -e $line; done'
alias network='nmtui'
alias close='systemctl suspend'
alias cls='clear'

# Remote drive aliases.
alias gdrive='rclone mount gdrive: ~/Remote/gdrive --vfs-cache-mode full & > /dev/null && cd ~/Remote/gdrive'
alias stopgdrive='fusermount -u ~/Remote/gdrive'
alias odgoogle='rclone mount odgoogle: ~/Remote/odgoogle --vfs-cache-mode full & > /dev/null && cd ~/Remote/odgoogle' # One drive google account
alias stopodgoogle='fusermount -u ~/Remote/odgoogle'

# Stop old wine, and run wine 11
alias wine11='pkill wineserver && /opt/wine-stable/bin/wineserver'

# Set up second monitor (hdmi) above main display. Need to reset i3 or windows persist across changing workspaces.
alias monitor='xrandr --output HDMI-2 --auto --above eDP-1 --mode 1920x1080 --rate 100 && i3-msg restart'
alias monitoroff='xrandr --output HDMI-2 --off'

alias resetti='/opt/resetti/resetti mc'

# connect to pwn.college terminal
alias pwnssh='ssh -i ~/.ssh/id_ed25519 hacker@dojo.pwn.college'

# Start pwn3adventure master server.
alias pwn3server='cd ~/Games/pwnieisland/PwnAdventure3/PwnAdventure3/Binaries/Linux/; ./PwnAdventure3Server'
alias pwn3master='cd ~/Games/pwnieisland/PwnAdventure3Servers/MasterServer/ && sudo su postgres sh -c "export LD_LIBRARY_PATH=.:$LD_LIBRARY_PATH; ./MasterServer"'

# evremap remap alias - set as f3 for now but may change as more functionality added
alias f3='sudo ~/.local/share/evremap/evremap-master/target/release/evremap remap ~/.config/evremap/config.toml'

# ls everything that appeared in last 5 mins
alias latest='find -mmin -5'

# Create http server in directory.
alias server='python3 -m http.server'
