[
  {
    "name": "System Updates",
    "description": "Updating system packages.",
    "script": [
        "if [[ \"$PKGM\" == \"apt\" ]]; then",
        "   sudo apt update -y",
        "   sudo apt upgrade -y",
        "elif [[ \"$PKGM\" == \"pacman\" ]]; then",
        "   sudo pacman -Syu",
        "fi"
    ]
  },
  {
    "name": "Unnecessary Software Removal",
    "description": "Removing unecessary software preinstalled on Linux Mint.",
    "script": [
        "sudo apt remove -y -s firefox",
        "sudo apt remove -y -s thunderbird",
        "sudo apt autoremove -y"
    ]
  }
]
